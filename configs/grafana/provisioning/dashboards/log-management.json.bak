  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "text": "全部级别",
          "value": ".*"
        },
        "hide": 0,
        "label": "日志级别",
        "name": "log_level",
        "options": [
          {
            "selected": true,
            "text": "全部级别",
            "value": ".*"
          },
          {
            "selected": false,
            "text": "错误",
            "value": "ERR|ERROR|FATAL|PANIC"
          },
          {
            "selected": false,
            "text": "警告",
            "value": "WARN|WARNING"
          },
          {
            "selected": false,
            "text": "信息",
            "value": "INF|INFO|DEBUG"
          }
        ],
        "query": ".* : ERR|ERROR|FATAL|PANIC : WARN|WARNING : INF|INFO|DEBUG",
        "skipUrlSync": false,
        "type": "custom"
      },
      {
        "current": {
          "selected": true,
          "text": "最近24小时",
          "value": "24h"
        },
        "hide": 0,
        "label": "时间范围",
