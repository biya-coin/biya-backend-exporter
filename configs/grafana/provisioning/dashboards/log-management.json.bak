          {
            "selected": false,
            "text": "最近1小时",
            "value": "1h"
          },
          {
            "selected": false,
            "text": "最近6小时",
            "value": "6h"
          },
          {
            "selected": true,
            "text": "最近24小时",
            "value": "24h"
          },
          {
            "selected": false,
            "text": "最近7天",
            "value": "7d"
          }
        ],
        "query": "1h : 6h : 24h : 7d",
        "skipUrlSync": false,
        "type": "custom"
      },
      {
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "hide": 0,
