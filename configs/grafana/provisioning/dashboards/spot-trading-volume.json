          "rawSql": "SELECT\n    time,\n    cumulative_volume\nFROM (\n    SELECT\n        toDateTime(trade_date) AS time,\n        sum(toFloat64(daily_volume)) OVER (ORDER BY trade_date) AS cumulative_volume\n    FROM (\n        SELECT\n            trade_date,\n            sum(daily_volume) AS daily_volume\n        FROM chart.spot_daily_trading_volume\n        WHERE trade_date >= today() - 365 AND trade_date <= today()\n        GROUP BY trade_date\n    ) AS daily_totals\n)\nORDER BY time ASC",
